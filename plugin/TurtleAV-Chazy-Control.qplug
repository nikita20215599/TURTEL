-- Turtle AV Chazy Control / Chazy4K Q-SYS Plugin
-- Control protocol: "Chazy Control API" over TELNET (default TCP/23) or SSH terminal.
-- This plugin uses TELNET-style plain TCP commands (line-based).
--
-- Sources referenced:
-- - docs/Chazy-Control-API.pdf (converted to docs/Chazy-Control-API.txt)
-- - docs/User-Guide-Chazy-Control.pdf (converted to docs/User-Guide-Chazy-Control.txt)

PluginInfo = {
  Name = "Turtle AV~Chazy Control~Chazy4K Router (1.0.0)",
  Version = "1.0.0",
  BuildVersion = "1.0.0.0",
  Id = "turtleav.chazy-control.chazy4k-router.1.0.0",
  Author = "Generated by Cursor Cloud Agent",
  Manufacturer = "Turtle AV",
  Model = "Chazy Control / Chazy4K",
  Description = "Routes Chazy4K encoders (TX) to decoders (RX) using the published Chazy Control API over TCP (TELNET). Provides basic status polling and stream preview URLs.",
  IsManaged = true,
  ShowDebug = true,
}

-- -----------------------------
-- Design-time configuration
-- -----------------------------

local Colors = {
  Bg = { 245, 247, 250 },
  Group = { 255, 255, 255 },
  Stroke = { 35, 38, 45 },
  Muted = { 90, 96, 108 },
  Ok = { 46, 204, 113 },
  Bad = { 231, 76, 60 },
  Accent = { 52, 152, 219 },
}

local PageNames = { "Control", "Setup", "Diagnostics" }

function GetColor(props)
  return { 52, 152, 219 }
end

function GetPrettyName(props)
  return "Chazy Control Router " .. PluginInfo.Version
end

function GetPages(props)
  local pages = {}
  for i = 1, #PageNames do
    table.insert(pages, { name = PageNames[i] })
  end
  return pages
end

function GetProperties()
  local props = {}

  table.insert(props, {
    Name = "Host",
    Type = "string",
    Value = "192.168.6.100", -- User guide default Control LAN, but either LAN may work
  })

  table.insert(props, {
    Name = "Port",
    Type = "integer",
    Min = 1,
    Max = 65535,
    Value = 23, -- TELNET default per API guide
  })

  table.insert(props, {
    Name = "Auth Mode",
    Type = "enum",
    Choices = { "None", "Username/Password (best-effort)" },
    Value = "None",
  })

  table.insert(props, {
    Name = "Username",
    Type = "string",
    Value = "",
  })

  table.insert(props, {
    Name = "Password",
    Type = "string",
    Value = "",
  })

  table.insert(props, {
    Name = "RX Count",
    Type = "integer",
    Min = 1,
    Max = 64,
    Value = 8,
  })

  table.insert(props, {
    Name = "TX Count",
    Type = "integer",
    Min = 1,
    Max = 64,
    Value = 8,
  })

  table.insert(props, {
    Name = "Poll Interval (s)",
    Type = "integer",
    Min = 0,
    Max = 60,
    Value = 5,
  })

  table.insert(props, {
    Name = "Preview URL Mode",
    Type = "enum",
    Choices = { "Off", "Fetch TX MSURL (recommended)" },
    Value = "Fetch TX MSURL (recommended)",
  })

  table.insert(props, {
    Name = "Debug",
    Type = "enum",
    Choices = { "Off", "Errors", "Info", "Verbose" },
    Value = "Errors",
  })

  return props
end

function RectifyProperties(props)
  local authMode = props["Auth Mode"] and props["Auth Mode"].Value or "None"
  if props["Username"] then props["Username"].IsHidden = (authMode == "None") end
  if props["Password"] then props["Password"].IsHidden = (authMode == "None") end
  return props
end

function GetControls(props)
  local ctrls = {}
  local rxCount = props["RX Count"].Value
  local txCount = props["TX Count"].Value

  -- Global / session controls
  table.insert(ctrls, { Name = "Connect", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input" })
  table.insert(ctrls, { Name = "Disconnect", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input" })
  table.insert(ctrls, { Name = "Refresh", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input" })
  table.insert(ctrls, { Name = "FetchPreviewUrls", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input" })

  table.insert(ctrls, { Name = "Connected", ControlType = "Indicator", IndicatorType = "Led", UserPin = true, PinStyle = "Output" })
  -- Use plain Text indicator for maximum compatibility across Q-SYS versions.
  table.insert(ctrls, { Name = "Status", ControlType = "Indicator", IndicatorType = "Text", UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "LastError", ControlType = "Indicator", IndicatorType = "Text", UserPin = true, PinStyle = "Output" })
  table.insert(ctrls, { Name = "LastResponse", ControlType = "Indicator", IndicatorType = "Text", UserPin = true, PinStyle = "Output" })

  -- A simple matrix: per RX choose TX and "Take"
  for rx = 1, rxCount do
    table.insert(ctrls, {
      Name = string.format("Rx%02d_SelectTx", rx),
      ControlType = "Knob",
      ControlUnit = "Integer",
      UserPin = true,
      PinStyle = "Input",
    })
    table.insert(ctrls, {
      Name = string.format("Rx%02d_Take", rx),
      ControlType = "Button",
      ButtonType = "Trigger",
      UserPin = true,
      PinStyle = "Input",
    })
    table.insert(ctrls, {
      Name = string.format("Rx%02d_Clear", rx),
      ControlType = "Button",
      ButtonType = "Trigger",
      UserPin = true,
      PinStyle = "Input",
    })

    table.insert(ctrls, {
      Name = string.format("Rx%02d_ActiveTx", rx),
      ControlType = "Indicator",
      IndicatorType = "Text",
      UserPin = true,
      PinStyle = "Output",
    })

    table.insert(ctrls, {
      Name = string.format("Rx%02d_PreviewUrl", rx),
      ControlType = "Indicator",
      IndicatorType = "Text",
      UserPin = true,
      PinStyle = "Output",
    })
  end

  -- Per TX preview URL (mainstream URL)
  for tx = 1, txCount do
    table.insert(ctrls, {
      Name = string.format("Tx%02d_MSURL", tx),
      ControlType = "Indicator",
      IndicatorType = "Text",
      UserPin = true,
      PinStyle = "Output",
    })
  end

  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local page = PageNames[props["page_index"].Value]
  local rxCount = props["RX Count"].Value
  local txCount = props["TX Count"].Value

  local x, y = 10, 10

  local function groupBox(text, px, py, w, h)
    table.insert(graphics, {
      Type = "GroupBox",
      Text = text,
      Fill = Colors.Group,
      StrokeColor = Colors.Stroke,
      StrokeWidth = 1,
      CornerRadius = 8,
      HTextAlign = "Left",
      Position = { px, py },
      Size = { w, h },
    })
  end

  local function label(text, px, py, w, h)
    table.insert(graphics, {
      Type = "Text",
      Text = text,
      Color = Colors.Muted,
      Font = "Roboto",
      FontSize = 12,
      FontStyle = "Regular",
      HTextAlign = "Left",
      Position = { px, py },
      Size = { w, h },
    })
  end

  if page == "Control" then
    local headerH = 120
    groupBox("Session", x, y, 740, headerH)
    layout["Connect"] = { PrettyName = "Session~Connect", Style = "Button", Position = { x + 20, y + 30 }, Size = { 90, 24 } }
    layout["Disconnect"] = { PrettyName = "Session~Disconnect", Style = "Button", Position = { x + 120, y + 30 }, Size = { 90, 24 } }
    layout["Refresh"] = { PrettyName = "Session~Refresh Status", Style = "Button", Position = { x + 220, y + 30 }, Size = { 120, 24 } }
    layout["FetchPreviewUrls"] = { PrettyName = "Session~Refresh Preview URLs", Style = "Button", Position = { x + 350, y + 30 }, Size = { 160, 24 } }

    label("Connected:", x + 20, y + 70, 80, 16)
    layout["Connected"] = { PrettyName = "Session~Connected", Style = "Led", Position = { x + 110, y + 70 }, Size = { 16, 16 } }
    layout["Status"] = { PrettyName = "Session~Status", Style = "Text", Position = { x + 140, y + 66 }, Size = { 590, 24 } }

    y = y + headerH + 10

    local rowH = 26
    local boxH = 40 + (rxCount * rowH) + 10
    groupBox("Routing (RX → TX)", x, y, 740, boxH)
    label("Tip: Set TX number then press Take. Use Clear to unroute.", x + 20, y + 20, 700, 16)
    label("RX", x + 20, y + 45, 40, 16)
    label("Select TX", x + 90, y + 45, 90, 16)
    label("Actions", x + 220, y + 45, 120, 16)
    label("Active TX", x + 360, y + 45, 80, 16)
    label("Preview URL (from TX)", x + 460, y + 45, 240, 16)

    for rx = 1, rxCount do
      local ry = y + 60 + (rx - 1) * rowH
      label(string.format("%02d", rx), x + 20, ry + 4, 40, 16)

      layout[string.format("Rx%02d_SelectTx", rx)] = { PrettyName = string.format("Routing~RX %02d Select TX", rx), Style = "Knob", Position = { x + 90, ry }, Size = { 90, 16 } }
      layout[string.format("Rx%02d_Take", rx)] = { PrettyName = string.format("Routing~RX %02d Take", rx), Style = "Button", Position = { x + 220, ry }, Size = { 60, 16 } }
      layout[string.format("Rx%02d_Clear", rx)] = { PrettyName = string.format("Routing~RX %02d Clear", rx), Style = "Button", Position = { x + 285, ry }, Size = { 60, 16 } }
      layout[string.format("Rx%02d_ActiveTx", rx)] = { PrettyName = string.format("Routing~RX %02d Active TX", rx), Style = "Text", Position = { x + 360, ry }, Size = { 90, 16 } }
      layout[string.format("Rx%02d_PreviewUrl", rx)] = { PrettyName = string.format("Routing~RX %02d Preview URL", rx), Style = "Text", Position = { x + 460, ry }, Size = { 260, 16 } }
    end

  elseif page == "Setup" then
    groupBox("Setup (Properties)", x, y, 740, 140)
    label("Use the Properties pane to configure Host/Port/RX Count/TX Count/Polling.", x + 20, y + 30, 700, 16)
    label("Default Control LAN: 192.168.6.100  |  Default Video LAN: 169.254.8.100", x + 20, y + 55, 700, 16)
    label("The Chazy Control API is TELNET/SSH terminal-based; this plugin uses TCP (TELNET).", x + 20, y + 80, 700, 16)
    label("Preview URLs come from: GET ENC <tx> SS MSURL (Gen2: MJPEG, Gen1: RTSP).", x + 20, y + 105, 700, 16)

  elseif page == "Diagnostics" then
    groupBox("Diagnostics", x, y, 740, 220)
    label("Last Error", x + 20, y + 30, 100, 16)
    layout["LastError"] = { PrettyName = "Diagnostics~Last Error", Style = "Text", Position = { x + 120, y + 30 }, Size = { 600, 16 } }

    label("Last Response (raw)", x + 20, y + 60, 150, 16)
    layout["LastResponse"] = { PrettyName = "Diagnostics~Last Response", Style = "Text", Position = { x + 20, y + 80 }, Size = { 700, 120 } }

    label(string.format("Configured TX Count: %d | RX Count: %d", txCount, rxCount), x + 20, y + 205, 700, 16)
  end

  return layout, graphics
end

-- -----------------------------
-- Runtime logic
-- -----------------------------

if Controls then
  local sock = TcpSocket.New()
  sock.ReadTimeout = 0
  sock.WriteTimeout = 0
  sock.ReconnectTimeout = 5

  local rxCount = tonumber(Properties["RX Count"].Value) or 8
  local txCount = tonumber(Properties["TX Count"].Value) or 8

  local txMsurl = {}      -- [tx] = url
  local rxActiveTx = {}   -- [rx] = tx (number) or 0

  local queue = {}
  local inFlight = nil
  local respLines = {}

  local respIdleTimer = Timer.New()
  respIdleTimer.EventHandler = function()
    if not inFlight then return end

    local raw = table.concat(respLines, "\n")
    Controls.LastResponse.String = raw

    local ok, err = pcall(function()
      if inFlight.parser then inFlight.parser(respLines, raw) end
    end)
    if not ok then
      Controls.LastError.String = tostring(err)
    end

    inFlight = nil
    respLines = {}
    respIdleTimer:Stop()
    -- send next
    if sock.IsConnected then
      if #queue > 0 then
        local nxt = table.remove(queue, 1)
        inFlight = nxt
        respLines = {}
        sock:Write(nxt.cmd .. "\r\n")
      end
    end
  end

  local function debugLevel()
    local v = Properties["Debug"] and Properties["Debug"].Value or "Errors"
    if v == "Off" then return 0 end
    if v == "Errors" then return 1 end
    if v == "Info" then return 2 end
    return 3
  end

  local function logInfo(...)
    if debugLevel() >= 2 then print(...) end
  end

  local function logVerbose(...)
    if debugLevel() >= 3 then print(...) end
  end

  local function setStatus(text, severity)
    -- severity: "OK" | "WARN" | "ERROR" | "INFO"
    local s = severity or "INFO"
    Controls.Status.String = text or ""
    if s == "OK" then
      Controls.Connected.Value = 1
    elseif s == "ERROR" then
      Controls.Connected.Value = 0
    end
  end

  local function sanitizeTelnetGarbage(s)
    if not s or s == "" then return s end
    -- Best-effort removal of TELNET IAC (0xFF) negotiation sequences.
    -- Q-SYS TcpSocket doesn't implement TELNET; some devices may still send negotiation bytes.
    local bytes = { string.byte(s, 1, #s) }
    local out = {}
    local i = 1
    while i <= #bytes do
      if bytes[i] == 255 then
        -- skip IAC + next two bytes if present
        i = i + 3
      else
        out[#out + 1] = bytes[i]
        i = i + 1
      end
    end
    return string.char(table.unpack(out))
  end

  local function enqueue(cmd, parser)
    table.insert(queue, { cmd = cmd, parser = parser })
    if sock.IsConnected and not inFlight then
      local nxt = table.remove(queue, 1)
      inFlight = nxt
      respLines = {}
      sock:Write(nxt.cmd .. "\r\n")
    end
  end

  local function updateRxPreview(rx)
    local tx = rxActiveTx[rx] or 0
    if tx == 0 then
      Controls[string.format("Rx%02d_PreviewUrl", rx)].String = ""
      return
    end
    Controls[string.format("Rx%02d_PreviewUrl", rx)].String = txMsurl[tx] or ""
  end

  local function parseSuccessOrError(lines)
    for _, ln in ipairs(lines) do
      if ln:match("^%[ERROR%]") then return false, ln end
      if ln:match("^%[SUCCESS%]") then return true, ln end
    end
    return true, nil
  end

  local function parseRxStatusForRoutes(lines)
    -- Parses GET DEC <rx|0> STATUS response(s) and tries to extract the active encoder (TX) for each decoder.
    -- The document shows a line:
    --   Vid /Aud /IR /Ser /USB /CEC
    -- followed by:
    --   000 /000 /000 /000 /000 /000
    local currentRx = nil
    for i = 1, #lines do
      local ln = lines[i]
      local rxId = ln:match("^%s*(%d%d%d)%s*$")
      if rxId and tonumber(rxId) then
        -- In per-RX status output, an "ID" column line appears with the RX value.
        -- We accept it as candidate current RX as long as it's within configured range.
        local v = tonumber(rxId)
        if v and v >= 1 and v <= rxCount then currentRx = v end
      end

      if ln:find("Vid /Aud", 1, true) then
        local nextLn = lines[i + 1] or ""
        local v, a = nextLn:match("(%d%d%d)%s*/%s*(%d%d%d)")
        if currentRx and v then
          local tx = tonumber(v) or 0
          rxActiveTx[currentRx] = tx
          Controls[string.format("Rx%02d_ActiveTx", currentRx)].String = (tx == 0) and "—" or tostring(tx)
          updateRxPreview(currentRx)
        end
      end
    end
  end

  local function parseTxMsurl(tx, lines)
    -- Example:
    -- Encoder 001 secondary stream MSURL:http://169.254.10.2:8080/?action=stream.
    for _, ln in ipairs(lines) do
      local url = ln:match("MSURL:(.+)")
      if url then
        url = url:gsub("%s+$", "")
        url = url:gsub("%.$", "")
        txMsurl[tx] = url
        Controls[string.format("Tx%02d_MSURL", tx)].String = url
        -- Update any RX previews that point at this TX
        for rx = 1, rxCount do
          if (rxActiveTx[rx] or 0) == tx then updateRxPreview(rx) end
        end
        return
      end
    end
  end

  local function fetchAllStatus()
    enqueue("GET STATUS", function(lines)
      local ok, msg = parseSuccessOrError(lines)
      if not ok then Controls.LastError.String = msg or "GET STATUS failed" end
    end)
    enqueue("GET DEC STATUS", function(lines)
      parseRxStatusForRoutes(lines)
    end)
  end

  local function fetchPreviewUrls()
    if (Properties["Preview URL Mode"] and Properties["Preview URL Mode"].Value) == "Off" then return end
    for tx = 1, txCount do
      enqueue(string.format("GET ENC %d SS MSURL", tx), function(lines)
        parseTxMsurl(tx, lines)
      end)
    end
  end

  local function doConnect()
    local host = tostring(Properties["Host"].Value or "")
    local port = tonumber(Properties["Port"].Value) or 23
    if host == "" then
      Controls.LastError.String = "Host is empty (set Properties → Host)"
      setStatus("Not configured: set Host in Properties", "ERROR")
      return
    end
    Controls.LastError.String = ""
    setStatus(string.format("Connecting to %s:%d…", host, port), "INFO")
    logInfo("Connecting to", host, port)
    sock:Connect(host, port)
  end

  -- Socket event handling
  sock.EventHandler = function(_, evt, err)
    if evt == TcpSocket.Events.Connected then
      Controls.Connected.Value = 1
      setStatus("Connected", "OK")
      Controls.LastError.String = ""
      logInfo("Connected to Chazy Control")

      -- Best-effort auth (if the TELNET session prompts for it; not all firmware does)
      if Properties["Auth Mode"] and Properties["Auth Mode"].Value ~= "None" then
        local u = Properties["Username"].Value or ""
        local p = Properties["Password"].Value or ""
        if u ~= "" then sock:Write(u .. "\r\n") end
        if p ~= "" then sock:Write(p .. "\r\n") end
      end

      -- Prime data
      fetchAllStatus()
      fetchPreviewUrls()

    elseif evt == TcpSocket.Events.Reconnect then
      setStatus("Reconnecting…", "WARN")
      logInfo("Reconnecting…")

    elseif evt == TcpSocket.Events.Data then
      -- Read all complete lines available
      local line = sock:ReadLine(TcpSocket.EOL.Any)
      while line ~= nil do
        line = sanitizeTelnetGarbage(line)
        if line ~= "" then
          respLines[#respLines + 1] = line
          logVerbose("RX:", line)
        end
        line = sock:ReadLine(TcpSocket.EOL.Any)
      end

      -- Start/extend idle timer; if no more data arrives, finalize response.
      if inFlight then
        respIdleTimer:Stop()
        respIdleTimer:Start(0.2)
      end

    elseif evt == TcpSocket.Events.Closed then
      Controls.Connected.Value = 0
      setStatus("Disconnected (remote closed)", "ERROR")
      logInfo("Disconnected (remote closed)")
      inFlight = nil
      respLines = {}

    elseif evt == TcpSocket.Events.Error or evt == TcpSocket.Events.Timeout then
      Controls.Connected.Value = 0
      Controls.LastError.String = tostring(err or "Socket error")
      setStatus("Disconnected (error)", "ERROR")
      logInfo("Socket error:", err)
      inFlight = nil
      respLines = {}
    end
  end

  -- User actions
  Controls.Connect.EventHandler = function()
    doConnect()
  end

  Controls.Disconnect.EventHandler = function()
    queue = {}
    inFlight = nil
    respLines = {}
    respIdleTimer:Stop()
    sock:Disconnect()
    setStatus("Disconnected (user)", "INFO")
  end

  Controls.Refresh.EventHandler = function()
    if not sock.IsConnected then
      Controls.LastError.String = "Not connected"
      return
    end
    fetchAllStatus()
  end

  Controls.FetchPreviewUrls.EventHandler = function()
    if not sock.IsConnected then
      Controls.LastError.String = "Not connected"
      return
    end
    fetchPreviewUrls()
  end

  for rx = 1, rxCount do
    local take = Controls[string.format("Rx%02d_Take", rx)]
    local clr = Controls[string.format("Rx%02d_Clear", rx)]
    local sel = Controls[string.format("Rx%02d_SelectTx", rx)]

    -- Set a sensible default on first run
    if sel.Value == nil or sel.Value == 0 then sel.Value = 1 end

    take.EventHandler = function()
      if not sock.IsConnected then
        Controls.LastError.String = "Not connected"
        return
      end
      local tx = math.floor(tonumber(sel.Value) or 0)
      if tx < 0 then tx = 0 end
      if tx > txCount then tx = txCount end
      enqueue(string.format("SET DEC %d SWITCH %d ALL", rx, tx), function(lines)
        local ok, msg = parseSuccessOrError(lines)
        if not ok then
          Controls.LastError.String = msg or "Route failed"
        else
          Controls.LastError.String = ""
          -- Refresh RX status after routing to confirm actual state
          enqueue(string.format("GET DEC %d STATUS", rx), function(stLines)
            parseRxStatusForRoutes(stLines)
          end)
        end
      end)
    end

    clr.EventHandler = function()
      if not sock.IsConnected then
        Controls.LastError.String = "Not connected"
        return
      end
      enqueue(string.format("SET DEC %d SWITCH 0 ALL", rx), function(lines)
        local ok, msg = parseSuccessOrError(lines)
        if not ok then
          Controls.LastError.String = msg or "Clear failed"
        else
          Controls.LastError.String = ""
          enqueue(string.format("GET DEC %d STATUS", rx), function(stLines)
            parseRxStatusForRoutes(stLines)
          end)
        end
      end)
    end
  end

  -- Polling
  local pollTimer = Timer.New()
  pollTimer.EventHandler = function()
    if not sock.IsConnected then return end
    fetchAllStatus()
  end

  local pollInterval = tonumber(Properties["Poll Interval (s)"].Value) or 5
  if pollInterval and pollInterval > 0 then
    pollTimer:Start(pollInterval)
  end

  -- Auto-connect on runtime start for user-friendliness.
  setStatus("Ready (press Connect or wait for auto-connect)", "INFO")
  local auto = Timer.New()
  auto.EventHandler = function()
    auto:Stop()
    if not sock.IsConnected then doConnect() end
  end
  auto:Start(0.2)
end

